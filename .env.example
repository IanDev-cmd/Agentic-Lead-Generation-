# Copy to .env and replace every placeholder.
# .env is gitignored. Never commit a real key, webhook secret, or desk token.

# Optional desk unlock. Leave empty and the server mints one per process, then
# sets it as a cookie for that browser. The browser never receives the webhook secret.
DESK_TOKEN=

# Optional directory for one run's report. The desk sets this per request.
LEADGEN_OUTPUT_DIR=

# Google AI Studio key. Create it at https://aistudio.google.com/apikey
# A live Deep Research call is documented as pay-as-you-go. Confirm the key's
# project has no billing surprise before DRY_RUN=false.
GEMINI_API_KEY=your-ai-studio-key

# Apps Script web app URL. It must be the deployment URL ending in /exec.
GOOGLE_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Shared secret. Same value goes in Apps Script: Project Settings > Script properties > WEBHOOK_SECRET.
# Use at least 16 random characters. The web app is anonymous at Google's layer; this secret is the lock.
WEBHOOK_SECRET=paste-a-long-random-string

# Agent id. Keep the preview agent. deep-research-max-preview-04-2026 is the expensive one.
DEEP_RESEARCH_AGENT=deep-research-preview-04-2026

# Optional CLI defaults. The desk sends the business profile with each run.
TARGET_INDUSTRY=independent logistics operators
TARGET_REGION=United States
SELLER_NAME=Your Name
SELLER_OFFERING=A short description of what you sell and who it is for
IDEAL_CUSTOMER_PROFILE=Operators with public evidence of manual dispatch or back-office work

# Caps the table the agent is asked for. Apps Script also refuses more than 15 rows.
MAX_LEADS=8

# Polling. Deep Research must run with background=true and can take up to 60 minutes.
POLL_INITIAL_DELAY_MS=5000
POLL_MAX_DELAY_MS=60000
POLL_BACKOFF_FACTOR=1.5
POLL_MAX_WAIT_MS=3600000
POLL_MAX_TRANSIENT_ERRORS=8

# Webhook POST timeout.
REQUEST_TIMEOUT_MS=120000

# Flags. REPORT_FILE and RESUME_INTERACTION_ID stay on the Node poller.
# DRY_RUN posts the Node fixture and does not call Gemini.
# A live run (DRY_RUN=false) asks the Python router which path to use.
# Paid Deep Research runs only when BILLING_ENABLED=true and the key probe does not report a billing block.
# Otherwise the free Flash + Google Search loop in fallback/ runs. DEMO_MODE never calls Gemini.
DRY_RUN=true
BILLING_ENABLED=false
FORCE_FREE_TIER=false
VERIFY_BILLING=true
DEMO_MODE=false
FREE_MODEL=gemini-2.5-flash
# Grounded searches per free run. gemini-2.5-flash free grounding is 500 requests/day, not 5,000/month.
FREE_GROUNDING_CALLS_PER_RUN=5
# Re-poll a run that already started, instead of paying for a second one.
RESUME_INTERACTION_ID=
# Replay a saved markdown file. Use this after a webhook failure.
REPORT_FILE=
